# Ignore compiled binaries
build/
dist/
/glesha

# Ignore local config files
/config.json
/config.toml
.env
.env.*
*.env

# Ignore IDE/editor settings
.idea/
.vscode/

# Ignore any backup or temporary files
*.bak
*.tmp
*.swp

# Ignore logs
*.log

# Ignore SQLite3 database files
*.db

# Ignore temporary files created during dev
*.dat

.worktrees/

*.sqlite
*.sqlite-journal
*.gpg
!archive/testdata/*.gpg
findings-*.md

# Ignore Python packaging caches
__pycache__/
*.py[cod]
