# Maintainer: toxdes <hi@toxdes.com>
pkgname=@PACKAGE@
pkgver=@VERSION@
pkgrel=1
pkgdesc=@DESCRIPTION@
arch=('x86_64' 'aarch64')
url=@HOMEPAGE@
license=('MIT')
provides=('glesha')
conflicts=('glesha' 'glesha-git')
depends=()
source_x86_64=(@URL_AMD64@)
sha256sums_x86_64=(@SHA256_AMD64@)
source_aarch64=(@URL_ARM64@)
sha256sums_aarch64=(@SHA256_ARM64@)

package() {
  install -Dm755 "$srcdir/bin/glesha" "$pkgdir/usr/bin/glesha"
  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/share/doc/glesha/config-sample.toml" "$pkgdir/usr/share/doc/glesha/config-sample.toml"
  for page in "$srcdir"/share/man/man1/*.1; do
    install -Dm644 "$page" "$pkgdir/usr/share/man/man1/${page##*/}"
  done
}
